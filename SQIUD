pixels_per_mm = None
calibrated = False
last_upload_time = 0
upload_interval = 30


def process_frames():
    global output_frame, pixels_per_mm, calibrated, last_upload_time

    print("🚀 Starting camera preview.")
    print("Press 'c' to calibrate (enter reference width in mm). Press 'q' to quit.")

    # --- Calibration loop ---
    while not calibrated:
        frame = read_frame()
        if frame is None:
            print("❌ Camera read failed. Retrying in 1s...")
            time.sleep(1)
            continue

        cv2.imshow("Calibration Preview (Undistorted) - Press 'c'", frame)
        key = cv2.waitKey(1) & 0xFF

        if key == ord('c'):
            try:
                ref_w = float(input("📐 Enter reference object width in mm: "))
                ppm = calibrate_pixels_to_mm(frame, ref_w)
                if ppm is None:
                    print("❌ Calibration failed: reference contour not detected. Try again.")
                    continue
                pixels_per_mm = ppm
                calibrated = True
                print(f"✅ Calibration done: {pixels_per_mm:.2f} pixels/mm")
            except ValueError:
                print("❌ Invalid input. Please enter numeric value.")
        elif key == ord('q'):
            print("👋 Quit during calibration.")
            if cap:
                cap.release()
            cv2.destroyAllWindows()
            return

    cv2.destroyWindow("Calibration Preview (Undistorted) - Press 'c'")
    print("✅ Starting real-time detection + contour measurement (undistorted frames)...")

    while True:
        frame = read_frame()
        if frame is None:
            print("❌ Camera read failed. Retrying in 1s...")
            time.sleep(1)
            continue

        # Detection
        try:
            results = model.infer(frame, confidence=0.4, overlap=30)[0]
            detections = sv.Detections.from_inference(results)
        except Exception as e:
            print("⚠️ Inference error:", e)
            traceback.print_exc()
            with lock:
                output_frame = frame.copy()
            time.sleep(0.01)
            continue

        xyxy = getattr(detections, "xyxy", None)
        if xyxy is None or len(xyxy) == 0:
            with lock:
                output_frame = frame.copy()
            cv2.imshow("Final Output (Undistorted) - q to quit", frame)
            if (cv2.waitKey(1) & 0xFF) == ord('q'):
                break
            continue

        # class names
        if "class_name" in detections.data and len(detections.data["class_name"]) == len(xyxy):
            class_names = list(detections.data["class_name"])
        else:
            try:
                class_names = [str(cid) for cid in detections.class_id]
            except Exception:
                class_names = [f"class_{i}" for i in range(len(xyxy))]
            detections.data["class_name"] = class_names

        det_boxes = [tuple(map(int, b)) for b in xyxy]

        # Contours full-frame (undistorted)
        contours = find_contours_fullframe(frame)
        det_to_contour = match_contours_to_detections(contours, det_boxes, min_iou=0.10)

        # defaults
        alu_w = alu_h = None
        hole_d = None
        slot_w = slot_h = None
        alu_status = hole_status = slot_status = "FAIL"

        status1, tag1, action1 = "Fail", "Unknown", "No action"
        status2, tag2, action2 = "Fail", "Unknown", "No action"
        status3, tag3, action3 = "Fail", "Unknown", "No action"

        annotated = box_annotator.annotate(scene=frame.copy(), detections=detections)

        for i, dbox in enumerate(det_boxes):
            class_name = class_names[i]
            x1, y1, x2, y2 = dbox
            matched_c = det_to_contour.get(i)

            width_px = max(0, x2 - x1)
            height_px = max(0, y2 - y1)

            if matched_c is not None:
                feat = contour_features(matched_c)
                w_px = max(feat["w_px"], feat["h_px"])
                h_px = min(feat["w_px"], feat["h_px"])
                circularity = feat["circularity"]
            else:
                w_px, h_px = float(width_px), float(height_px)
                circularity = 0.0

            w_mm = w_px / pixels_per_mm if pixels_per_mm else 0.0
            h_mm = h_px / pixels_per_mm if pixels_per_mm else 0.0

            tol = tolerances.get(class_name)

            if tol:
                if class_name == "Hole":
                    if matched_c is not None and pixels_per_mm:
                        (cx, cy), radius = cv2.minEnclosingCircle(matched_c)
                        diameter_mm = (2.0 * radius) / pixels_per_mm
                    else:
                        diameter_mm = (w_mm + h_mm) / 2.0

                    status = "PASS" if abs(diameter_mm - tol["diameter"]) <= tol["tol"] else "FAIL"
                    size_text = f"D={diameter_mm:.2f}mm"
                    hole_d, hole_status = diameter_mm, status

                else:
                    status = "PASS" if (
                        abs(w_mm - tol["width"]) <= tol["tol"] and
                        abs(h_mm - tol["height"]) <= tol["tol"]
                    ) else "FAIL"
                    size_text = f"{w_mm:.1f}mm x {h_mm:.1f}mm"

                    if class_name == "Alu_part":
                        alu_w, alu_h, alu_status = w_mm, h_mm, status
                    elif class_name == "slot":
                        slot_w, slot_h, slot_status = w_mm, h_mm, status
            else:
                status = "FAIL"
                size_text = f"{w_mm:.1f}mm x {h_mm:.1f}mm"

            if matched_c is not None:
                cv2.drawContours(annotated, [matched_c], -1, (255, 255, 0), 2)

            label = f"{class_name}: {size_text} {status}"
            text_color = (0, 255, 0) if status == "PASS" else (0, 0, 255)
            text_y = max(y1 - 10, 15)
            cv2.putText(annotated, label, (x1, text_y),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, text_color, 2)

        # ML calls
        if alu_w is not None and alu_h is not None:
            status1, tag1, action1 = predict_part_1(alu_w, alu_h)
        if hole_d is not None:
            status2, tag2, action2 = predict_part_2(hole_d)
        if slot_w is not None and slot_h is not None:
            status3, tag3, action3 = predict_part_3(slot_w, slot_h)

        # Upload
        if time.time() - last_upload_time >= upload_interval:
            print("⏳ Uploading to InfluxDB...")
            upload_to_influxdb(
                alu_w, alu_h, alu_status,
                hole_d, hole_status,
                slot_w, slot_h, slot_status,
                status1, tag1, action1,
                status2, tag2, action2,
                status3, tag3, action3
            )
            last_upload_time = time.time()

        with lock:
            output_frame = annotated.copy()

        cv2.imshow("Final Output (Undistorted) - q to quit", annotated)
        if (cv2.waitKey(1) & 0xFF) == ord('q'):
            print("👋 Quit detected.")
            break

    if cap:
        cap.release()
    cv2.destroyAllWindows()


# =========================
# Flask streaming
# =========================
def generate_frames():
    global output_frame
    while True:
        with lock:
            if output_frame is None:
                time.sleep(0.01)
                continue
            ok, buffer = cv2.imencode(".jpg", output_frame)
            if not ok:
                continue
            frame_bytes = buffer.tobytes()

        yield (b'--frame\r\n'
               b'Content-Type: image/jpeg\r\n\r\n' + frame_bytes + b'\r\n')


