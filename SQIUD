                <h1>Live Measurement + Detection Stream (Undistorted)</h1>
                <img src="/video_feed" width="800" />
                <p>Calibration happens in OpenCV window. Press 'c' to calibrate, 'q' to quit.</p>
            </body>
        </html>
    """)


@app.route('/video_feed')
def video_feed():
    return Response(generate_frames(), mimetype='multipart/x-mixed-replace; boundary=frame')


