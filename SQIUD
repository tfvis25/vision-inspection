# Calibration (pixels_per_mm)
# =========================
def calibrate_pixels_to_mm(frame, known_width_mm):
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    edged = cv2.Canny(blurred, 50, 150)
    contours, _ = cv2.findContours(edged, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    if not contours:
        return None

    largest_contour = max(contours, key=cv2.contourArea)
    x, y, w, h = cv2.boundingRect(largest_contour)
    if w <= 0:
        return None

    return w / float(known_width_mm)


# =========================
# Contours + matching helpers
# =========================
def contour_features(contour):
    area = cv2.contourArea(contour)
    peri = cv2.arcLength(contour, True)
    circularity = 0.0
    if peri > 1e-6:
        circularity = 4.0 * np.pi * area / (peri * peri)
    rect = cv2.minAreaRect(contour)
    (cx, cy), (rw, rh), angle = rect
    return {"area": area, "circularity": circularity, "minrect": rect, "w_px": rw, "h_px": rh}


def bbox_iou(a, b):
    xA = max(a[0], b[0]); yA = max(a[1], b[1])
    xB = min(a[2], b[2]); yB = min(a[3], b[3])
    interW = max(0, xB - xA); interH = max(0, yB - yA)
    interArea = interW * interH
    if interArea <= 0:
        return 0.0
    boxAArea = max(0, a[2]-a[0]) * max(0, a[3]-a[1])
    boxBArea = max(0, b[2]-b[0]) * max(0, b[3]-b[1])
    denom = boxAArea + boxBArea - interArea
    return interArea / denom if denom > 0 else 0.0


def find_contours_fullframe(frame):
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    _, thresh = cv2.threshold(blurred, 100, 255, cv2.THRESH_BINARY_INV)
    contours, _ = cv2.findContours(thresh, cv2.RETR_CCOMP, cv2.CHAIN_APPROX_SIMPLE)
    return [c for c in contours if cv2.contourArea(c) >= 300]


def match_contours_to_detections(contours, det_boxes, min_iou=0.10):
    det_to_best = {i: None for i in range(len(det_boxes))}
    det_to_best_score = {i: 0.0 for i in range(len(det_boxes))}
    for c in contours:
        x, y, w, h = cv2.boundingRect(c)
        cbox = (x, y, x+w, y+h)
        for i, dbox in enumerate(det_boxes):
            score = bbox_iou(cbox, dbox)
            if score >= min_iou and score > det_to_best_score[i]:
                det_to_best_score[i] = score
                det_to_best[i] = c
    return det_to_best


