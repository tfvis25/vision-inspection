def get_frame_from_http_snapshot():
    try:
        resp = requests.get(ESP32_URL, timeout=5)
        if resp.status_code == 200:
            arr = np.asarray(bytearray(resp.content), dtype=np.uint8)
            frame = cv2.imdecode(arr, cv2.IMREAD_COLOR)
            return frame
        print(f"⚠️ HTTP snapshot returned {resp.status_code}")
        return None
    except Exception as e:
        print("⚠️ HTTP snapshot fetch error:", e)
        return None


def read_frame():
    if use_cv_capture and cap:
        ret, frame = cap.read()
        if not ret or frame is None:
            frame = get_frame_from_http_snapshot()
    else:
        frame = get_frame_from_http_snapshot()

    if frame is None:
        return None

    # ✅ Always undistort first
    frame = undistort_frame(frame)
    return frame


