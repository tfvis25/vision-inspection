def load_calibration(calib_path: str):
    """
    Supports common pickle formats:
      - dict with keys: 'camera_matrix'/'mtx'/'K' and 'dist_coeffs'/'dist'/'D'
      - tuple/list: (K, D) or (K, D, rvecs, tvecs) etc.
    """
    if not os.path.exists(calib_path):
        print(f"⚠️ Calibration file not found: {calib_path} (running WITHOUT undistortion)")
        return None, None

    try:
        with open(calib_path, "rb") as f:
            data = pickle.load(f)

        K = D = None

        if isinstance(data, dict):
            # try common key names
            for kkey in ("camera_matrix", "mtx", "K", "intrinsic_matrix", "intrinsics"):
                if kkey in data:
                    K = np.array(data[kkey], dtype=np.float64)
                    break
            for dkey in ("dist_coeffs", "dist", "D", "distortion", "distCoeffs"):
                if dkey in data:
                    D = np.array(data[dkey], dtype=np.float64)
                    break

        elif isinstance(data, (list, tuple)) and len(data) >= 2:
            K = np.array(data[0], dtype=np.float64)
            D = np.array(data[1], dtype=np.float64)

        if K is None or D is None:
            print("⚠️ Calibration.pkl loaded but could not find camera_matrix/dist_coeffs. (running WITHOUT undistortion)")
            return None, None

        # sanity: camera matrix must be 3x3
        if K.shape != (3, 3):
            print(f"⚠️ Invalid camera matrix shape: {K.shape}. (running WITHOUT undistortion)")
            return None, None

        D = D.reshape(-1, 1) if D.ndim == 1 else D
        print("✅ Calibration loaded (fx, fy, cx, cy) and distortion coefficients.")
        return K, D

    except Exception as e:
        print(f"⚠️ Failed to load calibration file: {e} (running WITHOUT undistortion)")
        traceback.print_exc()
        return None, None


camera_matrix, dist_coeffs = load_calibration(CALIB_FILE)


def undistort_frame(frame):
    """
    Undistort using loaded calibration.
    Also updates optimal new camera matrix based on frame size (once).
    """
    global new_camera_matrix, calib_roi

    if camera_matrix is None or dist_coeffs is None:
        return frame

    h, w = frame.shape[:2]
    if new_camera_matrix is None:
        # alpha=0 crops more, alpha=1 keeps all pixels (black borders).
        new_camera_matrix, calib_roi = cv2.getOptimalNewCameraMatrix(
            camera_matrix, dist_coeffs, (w, h), alpha=0.8, newImgSize=(w, h)
        )

    und = cv2.undistort(frame, camera_matrix, dist_coeffs, None, new_camera_matrix)

    # Optional crop to valid ROI (recommended to avoid black borders)
    if calib_roi is not None:
        x, y, rw, rh = calib_roi
        if rw > 0 and rh > 0:
            und = und[y:y+rh, x:x+rw]
            # resize back so your detection window remains stable (optional)
            und = cv2.resize(und, (w, h), interpolation=cv2.INTER_LINEAR)

    return und


